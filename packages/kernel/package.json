{
    "name": "@napuketto/kernel",
    "version": "0.10.1",
    "description": "Core runtime kernel of NapukettoQQ",
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "files": [
        "dist"
    ],
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        }
    },
    "scripts": {
        "dev": "tsdown --watch",
        "build": "tsdown"
    },
    "devDependencies": {
        "tsdown": "catalog:"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/NapukettoDev/NapukettoQQ.git",
        "directory": "packages/kernel"
    },
    "dependencies": {
        "pino": "^10.4.0",
        "smol-toml": "^1.9.1"
    }
}
