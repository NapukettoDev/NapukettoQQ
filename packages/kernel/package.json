{
    "name": "@napuketto/kernel",
    "version": "0.2.1",
    "description": "Core runtime kernel of NapukettoQQ",
    "type": "module",
    "files": [
        "dist"
    ],
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "scripts": {
        "dev": "tsdown --watch",
        "build": "tsdown"
    },
    "devDependencies": {
        "tsdown": "^0.22.14",
        "vitest": "^4.1.10"
    },
    "license": "MIT",
    "dependencies": {
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "smol-toml": "^1.7.1"
    }
}