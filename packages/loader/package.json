{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "@napuketto/loader",
    "version": "0.17.0",
    "type": "module",
    "description": "Standalone host and native wrapper.node loader for Napuketto (without launching or injecting into QQNT).",
    "keywords": [
        "qqnt",
        "bot",
        "napuketto",
        "loader",
        "native",
        "headless"
    ],
    "homepage": "https://github.com/NapukettoDev/Napuketto/tree/main/packages/loader#readme",
    "bugs": {
        "url": "https://github.com/NapukettoDev/Napuketto/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/NapukettoDev/Napuketto.git",
        "directory": "packages/loader"
    },
    "license": "MIT",
    "author": {
        "name": "Oppenheymu",
        "email": "oppenheymu@gmail.com",
        "url": "https://github.com/Oppenheymu"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "files": [
        "dist",
        "assets/7zip",
        "native/prebuilt/linux-x64",
        "native/prebuilt/win32-x64",
        "releases.json"
    ],
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        }
    },
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch"
    },
    "dependencies": {
        "zod": "catalog:"
    },
    "devDependencies": {
        "tsdown": "catalog:"
    }
}
