{
    "name": "@napuketto/loader",
    "version": "0.0.32",
    "description": "NapukettoQQ 引导组件：自建宿主（标准 Node + stub QQNT.dll）dlopen wrapper.node 并启动 kernel，不拉起 QQ / 不注入",
    "type": "module",
    "files": [
        "dist",
        "native/build/stub-test-env",
        "qq-releases.json",
        "assets/7zip"
    ],
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "scripts": {
        "dev": "tsdown --watch",
        "build": "tsdown"
    },
    "dependencies": {
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "tsdown": "^0.22.14"
    },
    "license": "MIT"
}
