{
    "name": "@napuketto/loader",
    "version": "0.7.2",
    "description": "NapukettoQQ 引导组件：自建宿主（标准 Node + stub QQNT.dll）dlopen wrapper.node 并启动 kernel，不拉起 QQ / 不注入",
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "files": [
        "dist",
        "native/build/stub-test-env",
        "native/build/linux-x64",
        "qq-releases.json",
        "assets/7zip"
    ],
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        }
    },
    "scripts": {
        "dev": "tsdown --watch",
        "build": "tsdown"
    },
    "dependencies": {
        "zod": "catalog:"
    },
    "devDependencies": {
        "tsdown": "catalog:"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/NapukettoDev/NapukettoQQ.git",
        "directory": "packages/loader"
    }
}