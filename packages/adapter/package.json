{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "@napuketto/adapter",
    "version": "0.24.0",
    "type": "module",
    "description": "Protocol adapters (OneBot11 / Satori / KuroBot / Milky) for Napuketto",
    "keywords": [
        "bot",
        "napuketto",
        "adapter",
        "onebot",
        "satori",
        "kurobot",
        "milky"
    ],
    "homepage": "https://github.com/NapukettoDev/Napuketto/tree/main/packages/adapter#readme",
    "bugs": {
        "url": "https://github.com/NapukettoDev/Napuketto/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/NapukettoDev/Napuketto.git",
        "directory": "packages/adapter"
    },
    "license": "MIT",
    "author": {
        "name": "Oppenheymu",
        "email": "oppenheymu@gmail.com",
        "url": "https://github.com/Oppenheymu"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "files": [
        "dist"
    ],
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        },
        "./core": {
            "types": "./dist/core/index.d.mts",
            "default": "./dist/core/index.mjs"
        },
        "./kurobot": {
            "types": "./dist/kurobot/index.d.mts",
            "default": "./dist/kurobot/index.mjs"
        },
        "./milky": {
            "types": "./dist/milky/index.d.mts",
            "default": "./dist/milky/index.mjs"
        },
        "./onebot11": {
            "types": "./dist/onebot11/index.d.mts",
            "default": "./dist/onebot11/index.mjs"
        },
        "./satori": {
            "types": "./dist/satori/index.d.mts",
            "default": "./dist/satori/index.mjs"
        }
    },
    "tsdown": {
        "entry": {
            "index": "src/index.ts",
            "core/index": "src/framework/index.ts",
            "kurobot/index": "src/kurobot/index.ts",
            "milky/index": "src/milky/index.ts",
            "onebot11/index": "src/onebot11/index.ts",
            "satori/index": "src/satori/index.ts"
        }
    },
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch"
    },
    "dependencies": {
        "@napuketto/kernel": "workspace:*",
        "@napuketto/media": "workspace:*",
        "@napuketto/network": "workspace:*",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@types/ws": "catalog:",
        "tsdown": "catalog:",
        "ws": "catalog:"
    }
}
