{
    "name": "@napuketto/adapter",
    "version": "0.14.0",
    "description": "Protocol adapters (OneBot11 / Satori / KuroBot / Milky) for NapukettoQQ",
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "files": [
        "dist"
    ],
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        },
        "./core": {
            "types": "./dist/core/index.d.mts",
            "default": "./dist/core/index.mjs"
        },
        "./onebot11": {
            "types": "./dist/onebot11/index.d.mts",
            "default": "./dist/onebot11/index.mjs"
        },
        "./satori": {
            "types": "./dist/satori/index.d.mts",
            "default": "./dist/satori/index.mjs"
        },
        "./kurobot": {
            "types": "./dist/kurobot/index.d.mts",
            "default": "./dist/kurobot/index.mjs"
        },
        "./milky": {
            "types": "./dist/milky/index.d.mts",
            "default": "./dist/milky/index.mjs"
        }
    },
    "tsdown": {
        "entry": [
            "src/index.ts",
            "src/core/index.ts",
            "src/onebot11/index.ts",
            "src/satori/index.ts",
            "src/kurobot/index.ts",
            "src/milky/index.ts"
        ]
    },
    "scripts": {
        "dev": "tsdown --watch",
        "build": "tsdown"
    },
    "devDependencies": {
        "@types/ws": "catalog:",
        "tsdown": "catalog:",
        "ws": "catalog:"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/NapukettoDev/NapukettoQQ.git",
        "directory": "packages/adapter"
    },
    "dependencies": {
        "@napuketto/kernel": "workspace:*",
        "@napuketto/media": "workspace:*",
        "@napuketto/network": "workspace:*",
        "zod": "catalog:"
    }
}
