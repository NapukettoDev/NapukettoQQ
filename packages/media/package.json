{
    "name": "@napuketto/media",
    "version": "0.1.0",
    "description": "Media utilities for NapukettoQQ",
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "files": [
        "dist"
    ],
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        }
    },
    "scripts": {
        "dev": "tsdown --watch",
        "build": "tsdown"
    },
    "devDependencies": {
        "tsdown": "catalog:"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/NapukettoDev/NapukettoQQ.git",
        "directory": "packages/media"
    },
    "dependencies": {
        "execa": "^10.2.1",
        "file-type": "^22.3.0",
        "image-size": "^2.0.4",
        "silk-wasm": "^3.7.1"
    }
}
