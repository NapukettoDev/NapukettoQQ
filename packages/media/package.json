{
    "name": "@napuketto/media",
    "version": "0.0.7",
    "description": "Media utilities for NapukettoQQ",
    "type": "module",
    "files": [
        "dist"
    ],
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            },
            "types": "./dist/index.d.mts"
        }
    },
    "scripts": {
        "dev": "tsdown --watch",
        "build": "tsdown"
    },
    "devDependencies": {
        "tsdown": "^0.22.14"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/NapukettoDev/NapukettoQQ.git",
        "directory": "packages/media"
    },
    "dependencies": {
        "execa": "^10.0.1",
        "file-type": "^22.0.1",
        "image-size": "^2.0.2",
        "silk-wasm": "^3.7.1"
    }
}