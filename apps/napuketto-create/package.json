{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "create-napukettoqq",
    "version": "0.3.16",
    "type": "module",
    "description": "Scaffolding tool to quickly create a NapukettoQQ bot project (pnpm/npm/yarn create napukettoqq).",
    "keywords": [
        "qq",
        "bot",
        "napuketto",
        "create",
        "scaffold",
        "template",
        "cli"
    ],
    "homepage": "https://github.com/NapukettoDev/NapukettoQQ/tree/main/apps/napuketto-create#readme",
    "bugs": {
        "url": "https://github.com/NapukettoDev/NapukettoQQ/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/NapukettoDev/NapukettoQQ.git",
        "directory": "apps/napuketto-create"
    },
    "license": "MIT",
    "author": {
        "name": "Oppenheymu",
        "email": "oppenheymu@gmail.com",
        "url": "https://github.com/Oppenheymu"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "files": [
        "dist",
        "templates"
    ],
    "bin": {
        "create-napukettoqq": "./dist/index.mjs"
    },
    "main": "./dist/index.mjs",
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch"
    },
    "dependencies": {
        "@clack/prompts": "^1.9.0"
    },
    "devDependencies": {
        "@napuketto/cli": "workspace:*",
        "tsdown": "catalog:"
    }
