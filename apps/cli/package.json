{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "@napuketto/cli",
    "version": "0.8.10",
    "type": "module",
    "description": "Command line interface for Napuketto",
    "keywords": [
        "bot",
        "napuketto",
        "cli",
        "terminal"
    ],
    "homepage": "https://github.com/NapukettoDev/Napuketto/tree/main/apps/cli#readme",
    "bugs": {
        "url": "https://github.com/NapukettoDev/Napuketto/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/NapukettoDev/Napuketto.git",
        "directory": "apps/cli"
    },
    "license": "MIT",
    "author": {
        "name": "Oppenheymu",
        "email": "oppenheymu@gmail.com",
        "url": "https://github.com/Oppenheymu"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "files": [
        "dist"
    ],
    "bin": {
        "napuketto": "./dist/index.mjs"
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        }
    },
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "start": "node ./dist/index.mjs"
    },
    "dependencies": {
        "@napuketto/adapter": "workspace:*",
        "@napuketto/kernel": "workspace:*",
        "@napuketto/loader": "workspace:*",
        "@napuketto/network": "workspace:*",
        "commander": "^15.1.0",
        "uqr": "^0.1.3"
    },
    "devDependencies": {
        "tsdown": "catalog:"
    }
}
