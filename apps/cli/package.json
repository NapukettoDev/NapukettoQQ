{
    "name": "@napuketto/cli",
    "version": "0.5.17",
    "description": "Command line interface for NapukettoQQ",
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "files": [
        "dist"
    ],
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        }
    },
    "bin": {
        "napuketto": "./dist/index.mjs"
    },
    "scripts": {
        "dev": "tsdown --watch",
        "build": "tsdown",
        "start": "node ./dist/index.mjs"
    },
    "devDependencies": {
        "tsdown": "catalog:"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/NapukettoDev/NapukettoQQ.git",
        "directory": "apps/cli"
    },
    "dependencies": {
        "@napuketto/adapter": "workspace:*",
        "@napuketto/kernel": "workspace:*",
        "@napuketto/loader": "workspace:*",
        "@napuketto/network": "workspace:*",
        "commander": "^15.0.0",
        "uqr": "^0.1.3"
    }
}
