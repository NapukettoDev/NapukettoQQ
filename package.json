{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "NapukettoQQ",
    "version": "1.0.0",
    "description": "",
    "type": "module",
    "private": true,
    "license": "MIT",
    "author": "睦 <oppenheymu@gmail.com>",
    "keywords": [],
    "scripts": {
        "dev": "node apps/cli/dist/index.mjs",
        "start": "node apps/cli/dist/index.mjs",
        "config": "node apps/cli/dist/index.mjs config",
        "prepare": "pnpm -r build",
        "build": "pnpm -r build",
        "lint": "biome lint .",
        "format": "biome format --write .",
        "check": "biome check . && tsc --noEmit",
        "fix": "biome check --write . && tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:health": "vitest run --coverage && pnpm dlx fallow health --coverage coverage/coverage-final.json",
        "changeset": "changeset",
        "sync:adapter-deps": "node scripts/release/sync-adapter-deps.ts",
        "release:dryrun": "pnpm changeset version && node scripts/release/sync-adapter-deps.ts --dry-run && pnpm -r build && node scripts/release/release-npm.ts --dry-run",
        "release": "pnpm changeset version && node scripts/release/sync-adapter-deps.ts && pnpm -r build && node scripts/release/release-npm.ts"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.4.1",
            "onFail": "download"
        }
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.6",
        "@changesets/cli": "^3.0.2",
        "@types/node": "^26.1.2",
        "@vitest/coverage-v8": "^5.0.0",
        "fallow": "^3.14.0",
        "typescript": "^7.0.2",
        "vitest": "^5.0.0"
    },
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "overrides": {
        "@typescript-eslint/*>typescript": "npm:@typescript/typescript6@6.0.2"
    }
}