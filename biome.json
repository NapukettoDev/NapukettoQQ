{
    "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": false,
        "includes": [
            "**/src/**/*.{ts,tsx,mts,cts,js,mjs,cjs,jsx}",
            "packages/*/tests/**/*.{ts,tsx,mts,cts,js,mjs,cjs,jsx}",
            "apps/*/tests/**/*.{ts,tsx,mts,cts,js,mjs,cjs,jsx}",
            "tooling/**/*.{ts,js,mjs}"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "correctness": {
                "noUnresolvedImports": "off",
                "noUnusedPrivateClassMembers": "error"
            },
            "complexity": {
                "useLiteralKeys": "off",
                "noUselessUndefinedInitialization": "error",
                "noForEach": "error",
                "noExcessiveCognitiveComplexity": {
                    "level": "error",
                    "options": {
                        "maxAllowedComplexity": 20
                    }
                }
            },
            "style": {
                "useNamingConvention": {
                    "level": "error",
                    "options": {
                        "strictCase": false,
                        "conventions": [
                            {
                                "selector": {
                                    "kind": "typeParameter"
                                },
                                "formats": ["PascalCase"]
                            },
                            {
                                "selector": {
                                    "kind": "typeMember"
                                },
                                "formats": ["camelCase", "snake_case", "PascalCase"]
                            },
                            {
                                "selector": {
                                    "kind": "objectLiteralMember"
                                },
                                "formats": ["camelCase", "snake_case", "CONSTANT_CASE"]
                            }
                        ]
                    }
                },
                "useImportType": "error",
                "useDefaultParameterLast": "error",
                "useConsistentArrayType": "error",
                "useArrayLiterals": "error",
                "noParameterProperties": "error",
                "useNodeAssertStrict": "error",
                "useFilenamingConvention": {
                    "level": "error",
                    "options": {
                        "filenameCases": ["camelCase", "kebab-case"]
                    }
                }
            },
            "suspicious": {
                "noEmptyBlockStatements": "error",
                "useErrorMessage": "error",
                "noSkippedTests": "error",
                "noConsole": {
                    "level": "error",
                    "options": {
                        "allow": ["log"]
                    }
                }
            },
            "performance": {
                "noAccumulatingSpread": "error",
                "useTopLevelRegex": "error",
                "noReExportAll": "error"
            },
            "nursery": {
                "noFloatingPromises": "error"
            }
        }
    },
    "overrides": [
        {
            "includes": [
                "packages/adapter/src/**/helper/**",
                "packages/adapter/src/internal/domain/sysmsg.ts"
            ],
            "linter": {
                "rules": {
                    "complexity": {
                        "noExcessiveCognitiveComplexity": {
                            "level": "error",
                            "options": {
                                "maxAllowedComplexity": 25
                            }
                        }
                    }
                }
            }
        },
        {
            "includes": ["packages/adapter/src/framework/**"],
            "linter": {
                "rules": {
                    "style": {
                        "noRestrictedImports": {
                            "level": "error",
                            "options": {
                                "patterns": [
                                    {
                                        "group": ["**/internal/**"],
                                        "message": "framework/ 是公开契约层，禁止依赖包内私有实现（src/internal/）"
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        },
        {
            "includes": ["packages/kernel/src/apis/web.ts", "packages/kernel/src/apis/ticket.ts"],
            "linter": {
                "rules": {
                    "style": {
                        "useNamingConvention": "off"
                    }
                }
            }
        },
        {
            "includes": [
                "packages/kernel/tests/runtime/login/login.test.ts",
                "packages/kernel/tests/runtime/login/quick-login.test.ts"
            ],
            "linter": {
                "rules": {
                    "style": {
                        "useNamingConvention": "off"
                    }
                }
            }
        },
        {
            "includes": ["packages/kernel/src/types/**", "packages/kernel/src/infra/**"],
            "linter": {
                "rules": {
                    "style": {
                        "noRestrictedImports": {
                            "level": "error",
                            "options": {
                                "patterns": [
                                    {
                                        "group": ["**/native/**", "**/apis/**", "**/runtime/**"],
                                        "message": "L0（types/ 与 infra/）零内部依赖：禁止引用 native/、apis/、runtime/（kernel 五段式分层 DAG）"
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        },
        {
            "includes": ["packages/kernel/src/native/**"],
            "linter": {
                "rules": {
                    "style": {
                        "noRestrictedImports": {
                            "level": "error",
                            "options": {
                                "patterns": [
                                    {
                                        "group": ["**/apis/**", "**/runtime/**"],
                                        "message": "L1（native/）只可依赖 types/ 与 infra/：禁止引用 apis/、runtime/（kernel 五段式分层 DAG）"
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        },
        {
            "includes": ["packages/kernel/src/apis/**"],
            "linter": {
                "rules": {
                    "style": {
                        "noRestrictedImports": {
                            "level": "error",
                            "options": {
                                "patterns": [
                                    {
                                        "group": ["**/runtime/**"],
                                        "message": "L2（apis/）无状态：禁止引用 runtime/（登录 / 缓存 / 装配文件，kernel 五段式分层 DAG）"
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        },
        {
            "includes": [
                "**/*.test.ts",
                "**/*.test.tsx",
                "**/*.spec.ts",
                "**/__tests__/**",
                "**/tests/**"
            ],
            "linter": {
                "rules": {
                    "performance": {
                        "useTopLevelRegex": "off"
                    }
                }
            }
        }
    ],
    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "semicolons": "always",
            "trailingCommas": "all"
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
