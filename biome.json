{
    "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": false,
        "includes": [
            "**/src/**/*.{ts,tsx,mts,cts,js,mjs,cjs,jsx}",
            "packages/*/tests/**/*.{ts,tsx,mts,cts,js,mjs,cjs,jsx}",
            "apps/*/tests/**/*.{ts,tsx,mts,cts,js,mjs,cjs,jsx}",
            "tooling/**/*.{ts,js,mjs}"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "correctness": {
                "noUnresolvedImports": "off",
                "noUnusedPrivateClassMembers": "error"
            },
            "complexity": {
                "useLiteralKeys": "off",
                "noUselessUndefinedInitialization": "error",
                "noForEach": "off",
                "noExcessiveCognitiveComplexity": {
                    "level": "warn",
                    "options": {
                        "maxAllowedComplexity": 30
                    }
                }
            },
            "style": {
                "useNamingConvention": "off",
                "useImportType": "error",
                "useDefaultParameterLast": "error",
                "useConsistentArrayType": "error",
                "useArrayLiterals": "error",
                "noParameterProperties": "off",
                "useNodeAssertStrict": "error",
                "useFilenamingConvention": {
                    "level": "error",
                    "options": {
                        "filenameCases": ["camelCase", "kebab-case"]
                    }
                }
            },
            "suspicious": {
                "noEmptyBlockStatements": "warn",
                "useErrorMessage": "error",
                "noSkippedTests": "error",
                "noConsole": "error"
            },
            "performance": {
                "noAccumulatingSpread": "error",
                "useTopLevelRegex": "off",
                "noReExportAll": "off"
            },
            "nursery": {
                "noFloatingPromises": "error"
            }
        }
    },
    "overrides": [
        {
            "includes": ["apps/cli/**", "apps/create/**", "tooling/**"],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noConsole": "off"
                    }
                }
            }
        },
        {
            "includes": [
                "packages/*/src/index.ts",
                "packages/adapter/src/{framework,kurobot,milky,onebot11,satori}/index.ts"
            ],
            "linter": {
                "rules": {
                    "performance": {
                        "noReExportAll": "error"
                    }
                }
            }
        },
        {
            "includes": ["packages/{kernel,media,network,loader}/src/**", "apps/create/src/**"],
            "linter": {
                "rules": {
                    "style": {
                        "noRestrictedImports": {
                            "level": "error",
                            "options": {
                                "paths": {
                                    "@napuketto/adapter/core": "此层禁止依赖 adapter 的 ./core 入口"
                                }
                            }
                        }
                    }
                }
            }
        }
    ],
    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "semicolons": "always",
            "trailingCommas": "all"
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
