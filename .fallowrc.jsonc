{
    // CI 只检查架构边界。复杂度、重复和死代码保留供按需审阅。
    "$schema": "./node_modules/fallow/schema.json",
    // 锁死最低 fallow 版本，对齐单段 * glob 语义并防止旧版 CLI 漂移
    "minimumVersion": "3.44.0",
    // 私有 Git Submodule（Native Bypass 载具），不纳入主仓分析
    "ignorePatterns": [
        "packages/loader/native/**"
    ],
    // 复杂度用于提示。越层依赖由 CI 阻断。
    "rules": {
        "complexity-cyclomatic": "warn",
        "complexity-cognitive": "warn",
        "complexity-crap": "warn",
        "boundary-violation": "error"
    },
    // 审阅至少出现 3 次的重复，排除测试文件的 mock/fixture 样板。
    "duplicates": {
        "minOccurrences": 3,
        "minLines": 8,
        "minTokens": 50,
        "ignore": [
            "**/tests/**",
            "**/__tests__/**",
            "**/*.test.*"
        ]
    },
    // 与 vitest coverage.exclude 同口径：测试 / 工具脚本 / 纯门面 / 探针无业务逻辑
    "health": {
        "ignore": [
            "**/tests/**",
            "**/__tests__/**",
            "**/*.test.*",
            "**/*.test-d.*",
            "**/*.d.ts",
            "**/index.ts",
            "**/types.ts",
            "**/types/**",
            "tooling/**",
            "packages/kernel/src/native/probe/**",
            "packages/kernel/src/native/wrapper/wrapper-adapters.ts",
            "apps/cli/src/cli/program.ts",
            "apps/cli/src/cli/version.ts"
        ]
    },
    // 系统自带可执行文件（glibc），非 npm 包提供
    "ignoreBinaries": [
        "ldconfig"
    ],
    // 动态解析 / 运行时读取 package.json 的依赖
    "ignoreDependencies": [
        "@napuketto/network", // cli/boot.ts 通过 import.meta.resolve 动态加载
        "@napuketto/cli" // create-napuketto/scaffold.ts 读取自身依赖范围
    ],
    // 本文件已使用的导出不再报未使用（省掉 isOB11MessageSegment / isRawMessage 手写豁免）
    "ignoreExportsUsedInFile": true,
    // 精确导出豁免：仅保留真正对外预留的接口（host 侧日志转发接线补齐后移除）
    "ignoreExports": [
        {
            "file": "packages/loader/src/host/ipc/sender.ts",
            "exports": [
                "sendLog"
            ]
        }
    ],
    // 框架反射 / NAPI 回调 / 多态派发的类成员
    "usedClassMembers": [
        "name",
        "schema",
        "protocol",
        {
            "implements": "TransportAdapter",
            "members": [
                "send",
                "open",
                "close"
            ]
        },
        {
            "implements": "NodeIGlobalAdapter",
            "members": [
                "*"
            ]
        },
        {
            "implements": "NodeIDependsAdapter",
            "members": [
                "*"
            ]
        },
        {
            "implements": "NodeIDispatcherAdapter",
            "members": [
                "*"
            ]
        }
    ],
    // 死代码豁免：仅保留跨包 / 多态静态图追不到的误报，优先用目录或后缀模式
    "ignoreFindings": [
        // 协议 barrel：跨包按子路径消费，静态图只看到 re-export 未被引用
        "packages/adapter/src/onebot11/**/index.ts",
        "packages/adapter/src/satori/**/index.ts",
        // Satori 协议规范面（类型 + 废弃别名）供下游按协议文档消费
        "packages/adapter/src/satori/types/**",
        "packages/adapter/src/satori/action/base-action.ts",
        // kernel 公共门面与跨包语义 API（反射 / 动态装配调用）
        "packages/kernel/src/types/index.ts",
        "packages/kernel/src/native/index.ts",
        "packages/kernel/src/apis/**",
        "packages/kernel/src/native/bridge/*-bridge.ts",
        // 测试支撑由根 vitest 执行，不参与死代码治理
        "**/tests/**"
    ],
    // 架构分层边界（对齐 AGENTS.md 单向依赖约束 + adapter 四协议隔离）
    "boundaries": {
        "zones": [
            // 测试文件放在最前，避免跨层单测（如 framework/__tests__/auth.test.ts）触发误报
            {
                "name": "tests",
                "patterns": [
                    "**/tests/**",
                    "**/__tests__/**",
                    "**/*.test.*",
                    "**/*.test-d.*"
                ]
            },
            // kernel 各层向下依赖，包外生产代码经根出口访问。
            {
                "name": "kernel-l0",
                "patterns": [
                    "packages/kernel/src/types/**",
                    "packages/kernel/src/infra/**"
                ]
            },
            {
                "name": "kernel-l1",
                "patterns": [
                    "packages/kernel/src/native/**"
                ]
            },
            {
                "name": "kernel-l2",
                "patterns": [
                    "packages/kernel/src/apis/**"
                ]
            },
            {
                "name": "kernel-l3",
                "patterns": [
                    "packages/kernel/src/runtime/**"
                ]
            },
            {
                "name": "kernel-entry",
                "patterns": [
                    "packages/kernel/src/index.ts"
                ],
                "publicFiles": [
                    "packages/kernel/src/index.ts"
                ]
            },
            // 首个匹配的 zone 生效。未归层的源码需落在已定义层级后才能跨 zone 引用。
            {
                "name": "kernel-unclassified",
                "patterns": [
                    "packages/kernel/src/**"
                ]
            },
            // 底层三包互不依赖
            {
                "name": "media",
                "patterns": [
                    "packages/media/src/**"
                ]
            },
            {
                "name": "network",
                "patterns": [
                    "packages/network/src/**"
                ]
            },
            // 启动层：编译期不依赖其他内部包（运行期动态加载）
            {
                "name": "loader",
                "patterns": [
                    "packages/loader/src/**"
                ]
            },
            // 协议层内部细分：framework / internal / 四套独立协议 / 包入口
            {
                "name": "adapter-framework",
                "patterns": [
                    "packages/adapter/src/framework/**"
                ]
            },
            {
                "name": "adapter-internal",
                "patterns": [
                    "packages/adapter/src/internal/**"
                ]
            },
            {
                "name": "adapter-onebot11",
                "patterns": [
                    "packages/adapter/src/onebot11/**"
                ]
            },
            {
                "name": "adapter-satori",
                "patterns": [
                    "packages/adapter/src/satori/**"
                ]
            },
            {
                "name": "adapter-milky",
                "patterns": [
                    "packages/adapter/src/milky/**"
                ]
            },
            {
                "name": "adapter-kurobot",
                "patterns": [
                    "packages/adapter/src/kurobot/**"
                ]
            },
            {
                "name": "adapter-entry",
                "patterns": [
                    "packages/adapter/src/index.ts"
                ]
            },
            // 应用层
            {
                "name": "cli",
                "patterns": [
                    "apps/cli/src/**"
                ]
            },
            {
                "name": "create",
                "patterns": [
                    "apps/create/src/**"
                ]
            }
        ],
        "rules": [
            {
                "from": "kernel-l0",
                "allow": []
            },
            {
                "from": "kernel-l1",
                "allow": [
                    "kernel-l0"
                ]
            },
            {
                "from": "kernel-l2",
                "allow": [
                    "kernel-l0",
                    "kernel-l1"
                ]
            },
            {
                "from": "kernel-l3",
                "allow": [
                    "kernel-l0",
                    "kernel-l1",
                    "kernel-l2"
                ]
            },
            {
                "from": "kernel-entry",
                "allow": [
                    "kernel-l0",
                    "kernel-l1",
                    "kernel-l2",
                    "kernel-l3"
                ]
            },
            {
                "from": "kernel-unclassified",
                "allow": []
            },
            // media、network 与 loader 禁止引用其他内部 zone。
            {
                "from": "media",
                "allow": []
            },
            {
                "from": "network",
                "allow": []
            },
            {
                "from": "loader",
                "allow": []
            },
            // adapter 公共骨架与内部域不能反向依赖具体协议
            {
                "from": "adapter-framework",
                "allow": [
                    "kernel-entry",
                    "network",
                    "media"
                ]
            },
            {
                "from": "adapter-internal",
                "allow": [
                    "kernel-entry",
                    "network",
                    "media",
                    "adapter-framework"
                ]
            },
            // 四套协议彼此隔离，只能向下依赖底层三包 + framework + internal
            {
                "from": "adapter-onebot11",
                "allow": [
                    "kernel-entry",
                    "network",
                    "media",
                    "adapter-framework",
                    "adapter-internal"
                ]
            },
            {
                "from": "adapter-satori",
                "allow": [
                    "kernel-entry",
                    "network",
                    "media",
                    "adapter-framework",
                    "adapter-internal"
                ]
            },
            {
                "from": "adapter-milky",
                "allow": [
                    "kernel-entry",
                    "network",
                    "media",
                    "adapter-framework",
                    "adapter-internal"
                ]
            },
            {
                "from": "adapter-kurobot",
                "allow": [
                    "kernel-entry",
                    "network",
                    "media",
                    "adapter-framework",
                    "adapter-internal"
                ]
            },
            {
                "from": "adapter-entry",
                "allow": [
                    "adapter-framework",
                    "adapter-internal",
                    "adapter-onebot11",
                    "adapter-satori",
                    "adapter-milky",
                    "adapter-kurobot"
                ]
            },
            // 应用层单向向下
            {
                "from": "cli",
                "allow": [
                    "kernel-entry",
                    "network",
                    "loader",
                    "adapter-entry",
                    "adapter-framework",
                    "adapter-onebot11",
                    "adapter-satori",
                    "adapter-milky",
                    "adapter-kurobot"
                ]
            },
            {
                "from": "create",
                "allow": [
                    "cli"
                ]
            },
            // 测试文件允许直接访问已经归层的实现。
            {
                "from": "tests",
                "allow": [
                    "kernel-entry",
                    "kernel-l0",
                    "kernel-l1",
                    "kernel-l2",
                    "kernel-l3",
                    "media",
                    "network",
                    "loader",
                    "adapter-framework",
                    "adapter-internal",
                    "adapter-onebot11",
                    "adapter-satori",
                    "adapter-milky",
                    "adapter-kurobot",
                    "adapter-entry",
                    "cli",
                    "create"
                ]
            }
        ]
    }
}