{
    // fallow 配置（2026-08-08）：仅豁免已确认的误报源，不放松重复/复杂度阈值。
    // 目标：`pnpm dlx fallow` 输出只报真实问题，噪音清零。
    // 文件为 JSONC（带注释，符合项目风格）；fallow 自动发现本文件。
    "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
    // 手动入口：loader/src/host/ 是 tsdown 多入口（dist/host/self-host.cjs CJS bundle），
    // 不在 package.json exports 里，fallow 无法自动发现——声明后 host/ 目录不再报 unused。
    // scripts/wine/*.ts 是手动冒烟脚本（node scripts/... 直接跑），
    // 非 import 可达，声明为入口避免误报 unused-file。
    "entry": [
        "packages/loader/src/host/core/self-host.ts",
        "scripts/wine/wine-smoke.ts",
        "scripts/wine/wine-login-smoke.ts"
    ],
    // 完全排除：packages/loader/native/ 是私有 Git Submodule（Native Bypass 载具），
    // 仅分发编译后二进制，源脚本（verify/tools）不进主仓库分析范围。
    // apps/koishi-plugin-adapter 是 koishi 插件子模块（独立仓库自带工具链，主仓
    // biome/tsc 同样跳过）：插件 deps 由 koishi 框架运行时消费、vue/eslint 是其自身
    // 工具链，fallow 在主仓看不到可达性，纳入分析只报 11 个 unused-deps 误报 +
    // workspace glob WARN（2026-09-15 CI fallow audit 门禁引入时实测）。
    "ignorePatterns": [
        "packages/loader/native/**",
        "apps/koishi-plugin-adapter/**"
    ],
    // 未使用依赖豁免（用户拍板保留，勿删）：
    //  - @napuketto/network / @napuketto/adapter：cli 经 import.meta.resolve 动态解析（boot.ts），
    //    fallow 静态分析看不到
    //  - @napuketto/cli：create-napukettoqq 运行时读自身 package.json 的依赖范围（scaffold.ts）
    //  - picocolors / qrcode：预留（扫码/配色，后续实现）
    "ignoreDependencies": [
        "@napuketto/network",
        "@napuketto/adapter",
        "@napuketto/cli",
        "picocolors",
        "qrcode"
    ],
    // 预留导出豁免（勿删）：sendLog 是日志转发到 koishi 控制台（koishi 侧
    // ipc/types.ts 已有 log 消息类型 + IpcLogLevel），host 侧接线待补（P5）。
    "ignoreExports": [
        {
            "file": "packages/loader/src/host/ipc/ipc-sender.ts",
            "exports": [
                "sendLog"
            ]
        }
    ],
    // 框架反射使用的类成员（NAPI 按方法名反射调用，静态分析无引用）：
    //  - name / schema：ActionRegistry 按 action.name 索引、schema 校验（所有 Action 子类契约）
    //  - NodeI*Adapter 接口：engine/session init 的参数，NAPI 反射回调（wrapper-adapters.ts）
    "usedClassMembers": [
        "name",
        "schema",
        {
            "implements": "NodeIGlobalAdapter",
            "members": [
                "*"
            ]
        },
        {
            "implements": "NodeIDependsAdapter",
            "members": [
                "*"
            ]
        },
        {
            "implements": "NodeIDispatcherAdapter",
            "members": [
                "*"
            ]
        }
    ],
    // 隐藏抽象骨架与公共 API 面的死代码 finding（保留文件本身，不排除分析）：
    //  - core/base-action.ts / base-protocol-adapter.ts：抽象骨架契约方法
    //    （handle/websocketHandle/start/stop/reload 经 registry 反射/多态调用，静态分析追不到）
    //  - core/action-registry.ts：registry 公共方法（has/names）
    //  - satori/action/base-action.ts：Satori 动作抽象骨架（run 为执行入口）
    //  - onebot11/event/index.ts、onebot11/helper/index.ts：协议公共 barrel（re-export 被外部消费）
    //  - onebot11/helper/codec/index.ts、satori/helper/element/index.ts：DDD 拆分的子域 barrel
    //    （re-export 被上级 helper/index.ts / satori/index.ts 消费，fallow 静态分析看不到跨 barrel 链）
    //  - satori/types/**、satori/helper/ids.ts：协议规范类型/常量（P5 开发中，公共协议面）
    //  - onebot11/action/index.ts：协议动作公共面（79 动作类 + error-map + resolve-uid re-export，
    //    注册表与 barrel 双职责，外部经 onebot11/index.ts 只转发注册表部分，动作类为公共协议面）
    //  - satori/helper/index.ts：协议 helper 公共 barrel（ids 常量/频道构造器域内消费，fallow 看不到跨 barrel 链）
    //  - kernel types/apis/infra barrel（2026-08-08 规范化新增）：目录公共面 re-export
    //    （探测产物实体类型 / service 类型 / 构造选项类型，包门面 kernel/index.ts 只转发被消费部分）
    //  - loader host/ipc/index.ts：IPC 协议层公共 barrel（re-export 被 self-host.ts /
    //    bootstrap-core.ts 部分消费，其余为协议面保留，静态分析看不到跨 barrel 链）
    "ignoreFindings": [
        "packages/adapter/src/core/base-action.ts",
        "packages/adapter/src/core/base-protocol-adapter.ts",
        "packages/adapter/src/core/action-registry.ts",
        "packages/adapter/src/satori/action/base-action.ts",
        "packages/adapter/src/onebot11/event/index.ts",
        "packages/adapter/src/onebot11/helper/index.ts",
        "packages/adapter/src/onebot11/helper/codec/index.ts",
        "packages/adapter/src/satori/helper/element/index.ts",
        "packages/adapter/src/satori/types/**",
        "packages/adapter/src/satori/helper/ids.ts",
        "packages/adapter/src/onebot11/action/index.ts",
        "packages/adapter/src/satori/helper/index.ts",
        "packages/kernel/src/types/index.ts",
        "packages/kernel/src/types/services/index.ts",
        "packages/kernel/src/types/listeners/index.ts",
        "packages/kernel/src/infra/index.ts",
        "packages/kernel/src/apis/index.ts",
        "packages/loader/src/host/ipc/index.ts",
        // 测试文件（**/*.test.ts）：单包目录下跑 fallow 时 vitest 入口检测不到，
        // 测试文件被误判 unused files（dead files 26% 拉低 MI）。测试文件经
        // 根 vitest.config.ts 的 runner 执行，不是死代码——豁免 unused-file 判定
        // （保留复杂度/CRAP 检查，同 health.thresholdOverrides 精神）。
        "packages/kernel/src/**/*.test.ts",
        "packages/adapter/src/**/*.test.ts",
        "packages/loader/src/**/*.test.ts",
        "packages/network/src/**/*.test.ts",
        "packages/media/src/**/*.test.ts",
        "apps/**/*.test.ts",
        "scripts/**/*.test.ts"
    ],
    // 测试文件豁免大函数检查（fallow 官方推荐）：长 describe/it 块会被误计为
    // ">60 LOC 大函数"，污染 unit size 扣分（unit size = per_k 大函数数 × 0.5）。
    // 只提高 maxUnitSize，保留复杂度/认知/CRAP 检查（fallow 文档原文：
    // "Raising it for a glob removes those functions from the Large functions
    //  list while keeping complexity, cognitive, and CRAP checks on the same
    //  files, which is the recommended way to stop test suites from dominating
    //  the list"）。单元测试本就是多路径覆盖，不应按生产代码标准计大函数。
    "health": {
        "thresholdOverrides": [
            {
                "files": [
                    "**/*.test.*"
                ],
                "maxUnitSize": 200
            }
        ]
    }
}